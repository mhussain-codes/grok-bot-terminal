{
  "version": 2,
  "regions": ["fra1"],
  "functions": {
    "api/*.py": {
      "regions": ["fra1"]
    }
  },
  "rewrites": [
    {
      "source": "/api/state",
      "destination": "/api/state.py"
    },
    {
      "source": "/api/order",
      "destination": "/api/order.py"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
